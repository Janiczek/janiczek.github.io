install: PATH="/opt/homebrew/opt/ruby@3.4/bin:$PATH" bundle install
serve:   PATH="/opt/homebrew/opt/ruby@3.4/bin:$PATH" bundle exec jekyll serve --livereload
build:   PATH="/opt/homebrew/opt/ruby@3.4/bin:$PATH" bundle exec jekyll build
elm:     for x in $(grep -rl 'main =' src/); do BASE=$(echo "$x" | sed 's|^src/||; s|\.elm$||; s|/||g'); elm make "$x" --output "assets/js/$BASE.elm.js"; done
